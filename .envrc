# .envrc — direnv auto-loads this on cd into the project.
# `use flake` enters the nix devShell (clang, Qt via aqt in .sdk/, ffmpeg, gifski, just).
# quickrecord needs no secrets today; add them below with `just secrets-set` if that changes.

use flake

_secret() { secret-tool lookup service quickrecord key "$1" 2>/dev/null || true; }
